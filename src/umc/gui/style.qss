/* Tokens like @accent are replaced from umc.gui.theme at runtime. */

* {
    font-size: 14px;
    color: @text;
}

QWidget#Root, QWidget#Body, QScrollArea, QScrollArea > QWidget > QWidget#Content {
    background: @bg;
}

QLabel#Title {
    font-size: 15px;
    font-weight: 600;
}

QLabel#Subtitle, QLabel.muted, QLabel#Muted, QLabel#Help {
    color: @muted;
}

QLabel#Help {
    font-size: 12px;
}

QLabel#Section {
    font-size: 11px;
    font-weight: 600;
    color: @muted;
    letter-spacing: 1px;
    margin-top: 6px;
}

QLabel#GroupHeading {
    font-size: 12px;
    color: @muted;
    margin-top: 2px;
}

QLabel#Error {
    color: @danger;
}

QLabel#Success {
    color: @success;
}

/* ---------- top / bottom bars */
QFrame#TopBar {
    background: @surface;
    border-bottom: 1px solid @border;
}
QFrame#BottomBar {
    background: @surface;
    border-top: 1px solid @border;
}

/* ---------- Convert | Edit */
QFrame#ModeBar {
    background: @surface_alt;
    border-radius: 11px;
}
QPushButton#Segment {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 18px;
    min-width: 56px;
    color: @muted;
    font-weight: 500;
}
QPushButton#Segment:hover {
    color: @text;
}
QPushButton#Segment:checked {
    background: @surface;
    border-color: @border;
    color: @text;
    font-weight: 600;
}
QPushButton#Segment:disabled {
    color: @border_strong;
}

/* ---------- drop zone */
QFrame#DropZone {
    background: @surface;
    border: 2px dashed @border_strong;
    border-radius: 18px;
}
QFrame#DropZone:hover {
    border-color: @accent_border;
}
QFrame#DropZone[compact="true"] {
    border-radius: 14px;
    border-width: 1px;
}
QFrame#DropZone[hover="true"] {
    border-color: @accent;
    background: @accent_soft;
}
QLabel#DropTitle {
    font-size: 15px;
    font-weight: 600;
}
QFrame#DropZone[compact="true"] QLabel#DropTitle {
    font-size: 14px;
    font-weight: 500;
    color: @accent;
}

/* ---------- editor tiles (empty start screen) */
QPushButton#EditorTile {
    background: @surface;
    border: 1px solid @border;
    border-radius: 14px;
    padding: 0;
    text-align: left;
}
QPushButton#EditorTile:hover {
    border-color: @accent;
    background: @accent_soft;
}
QPushButton#EditorTile:disabled {
    background: @surface_alt;
    border-style: dashed;
}
QLabel#EditorTileTitle {
    font-size: 14px;
    font-weight: 600;
}
QPushButton#EditorTile:disabled QLabel#EditorTileTitle, QPushButton#EditorTile:disabled QLabel {
    color: @muted;
}

/* ---------- cards */
QFrame#Card {
    background: @surface;
    border: 1px solid @border;
    border-radius: 16px;
}
QLabel#CardTitle {
    font-weight: 600;
}
QLabel#EmptyHint {
    color: @muted;
    background: @surface;
    border: 1px solid @border;
    border-radius: 16px;
}

QListWidget#FileQueue, QListWidget#FileList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#ResultList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#ResultList::item {
    padding: 6px 6px;
    border-radius: 8px;
}
QListWidget#ResultList::item:hover, QListWidget#ResultList::item:selected {
    background: @surface_alt;
    color: @text;
}

/* ---------- Convert to / Settings panes */
QFrame#Pane {
    background: @surface;
    border: 1px solid @border;
    border-radius: 18px;
}
QFrame#Pane QScrollArea, QFrame#Pane QWidget#PaneBody {
    background: transparent;
}
QLabel#PaneTitle {
    font-size: 15px;
    font-weight: 600;
}
QToolButton#IconButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 5px;
}
QToolButton#IconButton:hover {
    background: @surface_alt;
    border-color: @border;
}

QFrame#CategoryCard {
    background: @bg;
    border: 1px solid @border;
    border-radius: 14px;
}
QToolButton#CardHeader {
    background: transparent;
    border: none;
    font-weight: 600;
    padding: 2px 0;
    text-align: left;
}
QToolButton#CardHeader:hover {
    color: @accent;
}
QLabel#Badge {
    border: 1px solid @accent_soft;
    background: @accent_soft;
    color: @accent;
    border-radius: 9px;
    padding: 1px 9px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#Count {
    color: @muted;
    font-size: 12px;
    padding: 1px 6px;
}
QToolButton#Tile {
    background: @surface;
    border: 1px solid @border;
    border-radius: 12px;
    padding: 6px 2px 4px 2px;
    font-size: 12px;
    font-weight: 500;
}
QToolButton#Tile:hover {
    border-color: @accent_border;
}
QToolButton#Tile:checked {
    background: @accent_soft;
    border: 2px solid @accent;
    color: @accent;
    font-weight: 600;
}

/* ---------- buttons */
QPushButton, QToolButton {
    background: @surface;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 7px 14px;
}
QPushButton:hover, QToolButton:hover {
    background: @surface_alt;
}
QPushButton:disabled {
    color: @muted;
}
QToolButton::menu-indicator {
    image: none;
}

QPushButton#Primary {
    background: @accent;
    border: none;
    color: @accent_text;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 26px;
    border-radius: 12px;
    min-width: 110px;
}
QPushButton#Primary:hover {
    background: @accent_hover;
}
QPushButton#Primary:disabled {
    background: @surface_alt;
    color: @muted;
}
QPushButton#Primary[danger="true"] {
    background: @danger;
}

QPushButton#Link, QToolButton#Link {
    background: transparent;
    border: none;
    color: @accent;
    padding: 2px 4px;
}
QPushButton#Link:hover, QToolButton#Link:hover {
    text-decoration: underline;
}
QPushButton#Link:disabled, QToolButton#Link:disabled {
    color: @muted;
}
QFrame#BottomBar QToolButton#Link {
    color: @muted;
}
QFrame#BottomBar QToolButton#Link:hover {
    color: @text;
    text-decoration: none;
}

QToolButton#Disclosure {
    background: transparent;
    border: none;
    font-weight: 600;
    padding: 4px 0;
}

/* ---------- inputs */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background: @surface_alt;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 6px 9px;
    min-height: 20px;
    selection-background-color: @accent;
    selection-color: @accent_text;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    border-color: @border;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: @accent;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 0;
    border: none;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @border;
    selection-background-color: @accent_soft;
    selection-color: @text;
    outline: none;
}

QSlider:horizontal {
    min-height: 22px; /* the 18 px handle sticks out above and below the 4 px groove */
}
QSlider::groove:horizontal {
    height: 4px;
    background: @surface_alt;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: @accent;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: @surface;
    border: 2px solid @accent;
    width: 14px;
    height: 14px;
    margin: -7px 0;
    border-radius: 9px;
}

QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid @border_strong;
    background: @surface;
}
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
}

QProgressBar {
    background: @surface_alt;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    min-height: 6px;
}
QProgressBar::chunk {
    background: @accent;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: @border_strong;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: @border_strong;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

QToolTip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    padding: 4px 6px;
}

QMenu {
    background: @surface;
    border: 1px solid @border;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: @accent_soft;
}

QDialog {
    background: @bg;
}

/* ---------- image editor */
QWidget#EditorPage {
    background: @bg;
}
QFrame#EditorTopBar {
    background: @surface;
    border-bottom: 1px solid @border;
}
QFrame#EditorStatus {
    background: @surface;
    border-top: 1px solid @border;
}
QPushButton#Small, QToolButton#SmallMenu {
    padding: 5px 12px;
    border-radius: 8px;
}
QPushButton#Small:disabled {
    color: @muted;
    background: @bg;
}
QFrame#EditorTopBar QPushButton#Primary {
    padding: 6px 22px;
    border-radius: 8px;
    font-size: 13px;
}
QToolButton#LookTile {
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 4px;
}
QToolButton#LookTile:checked {
    border-color: @accent;
    background: @accent_soft;
}
QToolButton#LookTile:hover {
    background: @surface_alt;
}
QLabel#ShortcutKey {
    font-weight: 600;
    color: @accent;
}
QFrame#CropBar {
    background: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
QPushButton#CropApply {
    background: @accent;
    color: @accent_text;
    border: none;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 8px;
}
QPushButton#CropApply:hover {
    background: @accent_hover;
}
QWidget#EditorToolBar {
    background: @surface;
    border-right: 1px solid @border;
}
QToolButton#ToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0;
}
QToolButton#ToolButton:hover {
    background: @surface_alt;
}
QToolButton#ToolButton:checked {
    background: @accent_soft;
    border-color: @accent;
}
QToolButton#Swatch {
    background: transparent;
    border: none;
    padding: 0;
}
QScrollArea#EditorSide, QWidget#EditorSideContent {
    background: @surface;
}
QScrollArea#EditorSide {
    border-left: 1px solid @border;
}
QListWidget#LayerList {
    background: @bg;
    border: 1px solid @border;
    border-radius: 10px;
    outline: none;
    padding: 4px;
}
QListWidget#LayerList::item {
    padding: 4px;
    border-radius: 8px;
}
QListWidget#LayerList::item:selected {
    background: @accent_soft;
    color: @text;
}
QWidget#EditorCanvas {
    background: @bg;
}


/* ---------- editor tool rail */
QScrollArea#ToolRail, QWidget#ToolRailHost {
    background: @surface;
}
QLabel#RailGroup {
    color: @muted;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 10px 6px 2px 6px;
}
QFrame#RailLine {
    color: @border;
    margin: 4px 6px;
}
QToolButton#RailButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 6px;
    text-align: left;
    font-size: 12px;
}
QToolButton#RailButton:hover {
    background: @accent_soft;
}
QToolButton#RailButton:checked {
    background: @accent_soft;
    border-color: @accent;
    color: @accent;
    font-weight: 600;
}
QToolButton#RailButton::menu-indicator {
    image: none;
}
QToolButton#RailToggle {
    background: transparent;
    border: none;
    padding: 2px;
}
QToolButton#RailButton[panel="open"] {
    background: @accent_soft;
}
QToolButton#RailButton[panel="minimised"] {
    border: 1px dashed @accent;
}

/* ---------- floating windows (editor) */
QFrame#FloatingPanel {
    background: @surface;
    border: 1px solid @border;
    border-radius: 10px;
}
QFrame#FloatingPanel QDialog, QWidget#PanelBody {
    background: transparent;
}
QFrame#PanelTitle {
    background: @surface_alt;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom: 1px solid @border;
}
QLabel#PanelTitleText {
    font-weight: 600;
    font-size: 12px;
}
QToolButton#PanelButton {
    background: transparent;
    border: none;
    padding: 3px;
    border-radius: 6px;
}
QToolButton#PanelButton:hover {
    background: @accent_soft;

/* Document editor: the page column */
#DocPage {
    background: white;
    color: black;
}
