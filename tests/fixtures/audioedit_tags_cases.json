  "_about_edit": "edit_cases: what editFor / edit_for writes for a save format. cover: \"jpeg\" = JPEG magic bytes, \"text\" = not a picture, null = none. want: null = nothing written; want.cover: whether the cover is written.",
  "edit_cases": [
    {
      "name": "an odd track number is left out, the rest kept",
      "fmt": "mp3",
      "values": {
        "title": "Song",
        "track": "A1",
        "year": "2024"
      },
      "cover": null,
      "want": {
        "values": {
          "title": "Song",
          "year": "2024"
        },
        "cover": false
      }
    },
    {
      "name": "numbers are written in their tidy form",
      "fmt": "flac",
      "values": {
        "track": " 3 / 12 ",
        "disc": "1"
      },
      "cover": null,
      "want": {
        "values": {
          "track": "3/12",
          "disc": "1"
        },
        "cover": false
      }
    },
    {
      "name": "a bad year alone writes nothing",
      "fmt": "m4a",
      "values": {
        "year": "May 2024"
      },
      "cover": null,
      "want": null
    },
    {
      "name": "a cover that isn't a JPG / PNG is skipped",
      "fmt": "mp3",
      "values": {
        "title": "Song"
      },
      "cover": "text",
      "want": {
        "values": {
          "title": "Song"
        },
        "cover": false
      }
    },
    {
      "name": "WAV holds no tags",
      "fmt": "wav",
      "values": {
        "title": "Song"
      },
      "cover": "jpeg",
      "want": null
    },
    {
      "name": "a JPG cover alone is written",
      "fmt": "m4a",
      "values": {},
      "cover": "jpeg",
      "want": {
        "values": {},
        "cover": true
      }
    }
  ]
